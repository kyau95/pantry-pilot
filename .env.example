# Pantry Pilot API Configuration
#
# Override backend API URL endpoint for local LAN testing, physical mobile devices, or custom deployment endpoints.
#
# Default behavior (if unset):
# - Web Browser: http://localhost:8000/api
# - Android Emulator: http://10.0.2.2:8000/api
# - iOS / Native: http://localhost:8000/api

# Example for physical mobile device testing on local Wi-Fi LAN:
# VITE_API_BASE_URL=http://192.168.1.100:8000/api

# Example for remote staging/production backend:
# VITE_API_BASE_URL=https://api.pantrypilot.app/api
